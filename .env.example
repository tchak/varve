# Copy to `.env` (gitignored) for local development.
# platform-server loads it at startup; real environment variables win.

DATABASE_URL=postgres://localhost/varve_platform_dev
# HOST=127.0.0.1
# PORT=3000
# The DB-gated tests read the real environment, NOT this file —
# export VARVE_TEST_DATABASE_URL yourself (or use direnv) to run them:
# VARVE_TEST_DATABASE_URL=postgres://localhost/varve_platform_test
